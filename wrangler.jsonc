{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leaser-corporate-gated",
  "main": "src/auth.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "www.leaserai.com/*", "zone_name": "leaserai.com" },
    { "pattern": "leaserai.com/*", "zone_name": "leaserai.com" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["BASIC_AUTH_USERNAME", "BASIC_AUTH_PASSWORD"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.01 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
